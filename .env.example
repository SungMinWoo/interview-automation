# Database
DB_USER=interview
DB_PASSWORD=changeme_db_password
DB_NAME=interview_site
DB_HOST=db
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=changeme_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000/api/v1

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# AI
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEFAULT_AI_PROVIDER=claude
STITCH_API_KEY=your_stitch_api_key

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@interview-site.com

# Survey
SURVEY_URL_EXPIRY_DAYS=7

# SSO / OAuth2
OAUTH2_CLIENT_ID=your_sso_client_id
OAUTH2_CLIENT_SECRET=your_sso_client_secret
OAUTH2_REDIRECT_CALLBACK_URI=http://localhost:3000/oauth/callback
OAUTH2_PROVIDER_URL=https://your-sso-provider.com
VITE_SSO_PROVIDER_URL=https://your-sso-provider.com
VITE_SSO_CLIENT_ID=your_sso_client_id
