# Database (PostgreSQL)
# 로컬: docker-compose의 db 컨테이너 사용 → DB_HOST=db, DB_SSLMODE=prefer
# 운영: AWS Lightsail 관리형 PostgreSQL → 아래 4개를 Lightsail 값으로 교체하고 DB_SSLMODE=require
DB_USER=interview
DB_PASSWORD=changeme_db_password
DB_NAME=interview_site
DB_HOST=db                 # Lightsail: ls-xxxx.xxxx.ap-northeast-2.rds.amazonaws.com 형태의 엔드포인트
DB_PORT=5432
# SSL 모드: prefer(로컬, SSL 있으면 쓰고 없으면 폴백) / require(Lightsail 등 관리형 — SSL 강제)
DB_SSLMODE=prefer
# 커넥션 재사용(초). 관리형 DB 권장. 0이면 매 요청 새 연결
DB_CONN_MAX_AGE=60

# Media (업로드 파일 저장 위치)
# 컨테이너 내부(/app/media)를 호스트의 이 경로에 bind mount → 도커 밖(호스트)에 영속 저장.
# 로컬은 기본값(프로젝트 루트의 ./media). 서버는 전용 디스크 경로 권장 (예: /var/app/media)
MEDIA_HOST_PATH=./media

# Django
DJANGO_SECRET_KEY=changeme_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000/api/v1

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# AI
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEFAULT_AI_PROVIDER=claude
STITCH_API_KEY=your_stitch_api_key

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@interview-site.com

# Survey
SURVEY_URL_EXPIRY_DAYS=7

# SSO / OAuth2
OAUTH2_CLIENT_ID=your_sso_client_id
OAUTH2_CLIENT_SECRET=your_sso_client_secret
OAUTH2_REDIRECT_CALLBACK_URI=http://localhost:3000/oauth/callback
OAUTH2_PROVIDER_URL=https://your-sso-provider.com
VITE_SSO_PROVIDER_URL=https://your-sso-provider.com
VITE_SSO_CLIENT_ID=your_sso_client_id
